@{
    ViewData["Title"] = "Lançar Notas";
}

<div class="container-fluid pb-5">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
        <h1 class="h2">Lançar Notas</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="@Url.Action("Dashboard", "Professor")" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading"><i class="bi bi-cone-striped me-2"></i>Em Construção</h4>
        <p>A funcionalidade de lançamento de notas está sendo implementada.</p>
        <hr>
        <p class="mb-0">Em breve você poderá selecionar a turma, avaliação e atribuir notas aos alunos aqui.</p>
    </div>
</div>
