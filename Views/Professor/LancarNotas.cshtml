@model EduManager.Models.ViewModels.LancarNotaViewModel
@{
    ViewData["Title"] = "Lançar Notas";
    var turmas = ViewBag.Turmas as IEnumerable<EduManager.Models.Entities.Dominios.TurmaDominio>;
}

<div class="container-fluid pb-5">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
        <h1 class="h2">Lançar Notas</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
             <a href="@Url.Action("Dashboard", "Professor")" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Nova Nota</h5>
                </div>
                <div class="card-body">
                    <form asp-action="LancarNotas" method="post">
                        <div class="mb-3">
                            <label for="TurmaId" class="form-label">Turma</label>
                            <select id="TurmaId" class="form-select" required onchange="carregarAlunos()">
                                <option value="">Selecione a Turma...</option>
                                @if (turmas != null)
                                {
                                    foreach (var turma in turmas)
                                    {
                                        <option value="@turma.TurmaId" data-disciplina-id="@turma.DisciplinaId">@turma.Nome - @turma.Disciplina?.Nome</option>
                                    }
                                }
                            </select>
                        </div>

                         <input type="hidden" asp-for="DisciplinaId" id="DisciplinaId" />

                        <div class="mb-3">
                            <label asp-for="AlunoId" class="form-label">Aluno</label>
                            <select asp-for="AlunoId" class="form-select" required disabled>
                                <option value="">Selecione um Aluno...</option>
                            </select>
                            <span asp-validation-for="AlunoId" class="text-danger"></span>
                        </div>

                         <div class="mb-3">
                            <label asp-for="TipoAvaliacao" class="form-label">Tipo de Avaliação</label>
                             <select asp-for="TipoAvaliacao" class="form-select" required>
                                <option value="Prova 1">Prova 1</option>
                                <option value="Prova 2">Prova 2</option>
                                <option value="Trabalho">Trabalho</option>
                                <option value="Seminário">Seminário</option>
                             </select>
                            <span asp-validation-for="TipoAvaliacao" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Valor" class="form-label">Nota (0 - 10)</label>
                            <input asp-for="Valor" type="number" step="0.1" min="0" max="10" class="form-control" required />
                            <span asp-validation-for="Valor" class="text-danger"></span>
                        </div>
                        
                         <div class="mb-3">
                            <label asp-for="DataAvaliacao" class="form-label">Data Avaliação</label>
                            <input asp-for="DataAvaliacao" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="DataAvaliacao" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Salvar Nota</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
             <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-center text-center text-muted">
                    <div>
                        <i class="bi bi-info-circle display-4 mb-3"></i>
                        <h5>Instruções</h5>
                        <p>Selecione a turma para carregar a lista de alunos.</p>
                        <p>Certifique-se de que a nota esteja entre 0 e 10.</p>
                    </div>
                </div>
             </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        @if (TempData["MensagemSucesso"] != null)
        {
            <text>
            Swal.fire({
                title: 'Sucesso!',
                text: '@TempData["MensagemSucesso"]',
                icon: 'success',
                confirmButtonText: 'OK'
            });
            </text>
        }

        @if (!ViewData.ModelState.IsValid)
        {
             <text>
            Swal.fire({
                title: 'Atenção!',
                html: '<ul>@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <li>@error.ErrorMessage</li> }</ul>',
                icon: 'warning',
                confirmButtonText: 'OK'
            });
            </text>
        }

        function carregarAlunos() {
            var turmaId = document.getElementById("TurmaId").value;
            var disciplinaId = document.getElementById("TurmaId").selectedOptions[0]?.getAttribute("data-disciplina-id");
            document.getElementById("DisciplinaId").value = disciplinaId;
            
            var alunoSelect = document.getElementById("AlunoId");
            
            alunoSelect.innerHTML = '<option value="">Carregando...</option>';
            alunoSelect.disabled = true;

            if (turmaId) {
                fetch('@Url.Action("GetAlunosPorTurma", "Professor")?turmaId=' + turmaId)
                    .then(response => response.json())
                    .then(data => {
                        alunoSelect.innerHTML = '<option value="">Selecione um Aluno...</option>';
                        data.forEach(aluno => {
                            var option = document.createElement("option");
                            option.value = aluno.alunoId;
                            option.text = aluno.alunoNomeCompleto;
                            alunoSelect.appendChild(option);
                        });
                        alunoSelect.disabled = false;
                    })
                    .catch(error => {
                        console.error('Erro:', error);
                        alunoSelect.innerHTML = '<option value="">Erro ao carregar</option>';
                        Swal.fire('Erro', 'Não foi possível carregar os alunos.', 'error');
                    });
            } else {
                alunoSelect.innerHTML = '<option value="">Selecione uma Turma primeiro</option>';
                 alunoSelect.disabled = true;
            }
        }
    </script>
}
