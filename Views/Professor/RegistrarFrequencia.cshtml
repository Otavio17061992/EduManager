@{
    ViewData["Title"] = "Registrar Frequência";
}

<div class="container-fluid pb-5">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
        <h1 class="h2">Registrar Frequência</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="@Url.Action("Dashboard", "Professor")" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading"><i class="bi bi-calendar-check me-2"></i>Funcionalidade em Breve</h4>
        <p>O módulo de frequência permitirá o controle diário de presença dos alunos por turma.</p>
        <hr>
        <p class="mb-0">Aguarde as próximas atualizações do sistema.</p>
    </div>
</div>
