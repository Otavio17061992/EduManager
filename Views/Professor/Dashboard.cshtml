@{
    ViewData["Title"] = "Painel do Professor";
}

<div class="container-fluid pb-5">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
        <h1 class="h2">Bem-vindo, Professor!</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <div class="btn-group me-2">
                <button type="button" class="btn btn-sm btn-outline-primary">Ver Relatórios</button>
            </div>
            <button type="button" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle"></i> Nova Turma
            </button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Turmas Ativas</p>
                            <h3 class="mb-0">5</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-book text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Alunos Matriculados</p>
                            <h3 class="mb-0">120</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-people text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Avaliações Pendentes</p>
                            <h3 class="mb-0">3</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-clipboard-check text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Mensagens</p>
                            <h3 class="mb-0">7</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="bi bi-envelope text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Próximas Aulas</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Matemática - Turma A
                            <span class="badge bg-primary rounded-pill">Hoje, 14:00</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Física - Turma B
                            <span class="badge bg-primary rounded-pill">Amanhã, 10:00</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Química - Turma C
                            <span class="badge bg-primary rounded-pill">Quinta, 16:00</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>