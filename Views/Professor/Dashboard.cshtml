@model EduManager.Models.ViewModels.ProfessorDashboardViewModel

@{
    ViewData["Title"] = "Painel do Professor";
}

<div class="container-fluid pb-5">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
        <div>
            <h1 class="h2">Bem-vindo, @Model.ProfessorNome!</h1>
            <p class="text-muted mb-0">@Model.Especialidade</p>
        </div>
        <div class="btn-toolbar mb-2 mb-md-0">
            <div class="btn-group me-2">
                <a href="@Url.Action("MinhasTurmas", "Professor")" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-people-fill"></i> Minhas Turmas
                </a>
            </div>
            <a href="@Url.Action("LancarNotas", "Professor")" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle"></i> Lançar Notas
            </a>
        </div>
    </div>

    <!-- Cards de Estatísticas -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Turmas Ativas</p>
                            <h3 class="mb-0">@Model.TotalTurmas</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-book text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Disciplinas</p>
                            <h3 class="mb-0">@Model.TotalDisciplinas</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-journal-text text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Total de Alunos</p>
                            <h3 class="mb-0">@Model.TotalAlunos</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="bi bi-people text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Avaliações Pendentes</p>
                            <h3 class="mb-0">@Model.AvaliacoesPendentes</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-clipboard-check text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Menu de Acesso Rápido -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="card-title fw-bold mb-0">Acesso Rápido</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a href="@Url.Action("MinhasTurmas", "Professor")" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-light rounded hover-shadow">
                                    <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
                                        <i class="bi bi-people-fill text-primary fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 text-dark">Minhas Turmas</h6>
                                        <small class="text-muted">Gerenciar turmas ativas</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="@Url.Action("MinhasDisciplinas", "Professor")" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-light rounded hover-shadow">
                                    <div class="bg-success bg-opacity-10 p-3 rounded me-3">
                                        <i class="bi bi-journal-text text-success fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 text-dark">Minhas Disciplinas</h6>
                                        <small class="text-muted">Ver disciplinas lecionadas</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="@Url.Action("LancarNotas", "Professor")" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-light rounded hover-shadow">
                                    <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
                                        <i class="bi bi-clipboard-check text-warning fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 text-dark">Lançar Notas</h6>
                                        <small class="text-muted">Registrar avaliações</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="@Url.Action("RegistrarFrequencia", "Professor")" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-light rounded hover-shadow">
                                    <div class="bg-info bg-opacity-10 p-3 rounded me-3">
                                        <i class="bi bi-calendar-check text-info fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 text-dark">Registrar Frequência</h6>
                                        <small class="text-muted">Controlar presença</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="@Url.Action("MeusAlunos", "Professor")" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-light rounded hover-shadow">
                                    <div class="bg-secondary bg-opacity-10 p-3 rounded me-3">
                                        <i class="bi bi-person-lines-fill text-secondary fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 text-dark">Meus Alunos</h6>
                                        <small class="text-muted">Lista de alunos</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="#" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-light rounded hover-shadow">
                                    <div class="bg-danger bg-opacity-10 p-3 rounded me-3">
                                        <i class="bi bi-file-earmark-text text-danger fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 text-dark">Relatórios</h6>
                                        <small class="text-muted">Gerar relatórios</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Minhas Turmas e Disciplinas -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="card-title fw-bold mb-0">Minhas Turmas Ativas</h5>
                </div>
                <div class="card-body px-4">
                    @if (Model.TurmasAtivas.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var turma in Model.TurmasAtivas.Take(5))
                            {
                                <div class="list-group-item border-0 px-0 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@turma.Nome</h6>
                                        <small class="text-muted">Ano: @turma.Ano</small>
                                    </div>
                                    <span class="badge bg-success">Ativa</span>
                                </div>
                            }
                        </div>
                        @if (Model.TurmasAtivas.Count > 5)
                        {
                            <div class="text-center mt-3">
                                <a href="@Url.Action("MinhasTurmas", "Professor")" class="btn btn-sm btn-outline-primary">
                                    Ver todas (@Model.TurmasAtivas.Count)
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">Nenhuma turma ativa no momento.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="card-title fw-bold mb-0">Minhas Disciplinas</h5>
                </div>
                <div class="card-body px-4">
                    @if (Model.MinhasDisciplinas.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var disciplina in Model.MinhasDisciplinas.Take(5))
                            {
                                <div class="list-group-item border-0 px-0 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@disciplina.Nome</h6>
                                        <small class="text-muted">Código: @disciplina.Codigo</small>
                                    </div>
                                    <span class="badge bg-primary">@disciplina.CargaHoraria h</span>
                                </div>
                            }
                        </div>
                        @if (Model.MinhasDisciplinas.Count > 5)
                        {
                            <div class="text-center mt-3">
                                <a href="@Url.Action("MinhasDisciplinas", "Professor")" class="btn btn-sm btn-outline-primary">
                                    Ver todas (@Model.MinhasDisciplinas.Count)
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">Nenhuma disciplina cadastrada.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body { background-color: #f8f9fa; }
    .card { transition: transform 0.2s; }
    .card:hover { transform: translateY(-2px); }
    .hover-shadow { transition: all 0.3s ease; }
    .hover-shadow:hover { 
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        transform: translateY(-2px);
    }
</style>