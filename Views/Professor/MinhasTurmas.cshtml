@model IEnumerable<EduManager.Models.Entities.Dominios.TurmaDominio>

@{
    ViewData["Title"] = "Minhas Turmas";
}

<div class="container-fluid pb-5">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
        <h1 class="h2">Minhas Turmas</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="@Url.Action("Dashboard", "Professor")" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    <div class="row g-4">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                            <h5 class="card-title fw-bold mb-0">@item.Nome</h5>
                            @if (item.Ativa)
                            {
                                <span class="badge bg-success">Ativa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativa</span>
                            }
                        </div>
                        <div class="card-body px-4">
                            <p class="text-muted mb-2"><i class="bi bi-calendar me-2"></i>Ano: @item.Ano</p>
                            <p class="text-muted mb-3"><i class="bi bi-journal-bookmark me-2"></i>@item.Disciplina?.Nome</p>
                            
                            <hr>
                            
                            <div class="d-grid gap-2">
                                <a href="#" class="btn btn-primary btn-sm">
                                    <i class="bi bi-people me-2"></i>Ver Alunos
                                </a>
                                <a href="#" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-check2-square me-2"></i>Frequência
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle me-2"></i> Você ainda não possui turmas cadastradas.
                </div>
            </div>
        }
    </div>
</div>
