@model IEnumerable<EduManager.Models.Entities.Dominios.DisciplinaDominio>

@{
    ViewData["Title"] = "Minhas Disciplinas";
}

<div class="container-fluid pb-5">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
        <h1 class="h2">Minhas Disciplinas</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="@Url.Action("Dashboard", "Professor")" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 px-4 py-3">Código</th>
                            <th class="border-0 px-4 py-3">Nome</th>
                            <th class="border-0 px-4 py-3">Curso</th>
                            <th class="border-0 px-4 py-3">Carga Horária</th>
                            <th class="border-0 px-4 py-3 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 fw-bold">@item.Codigo</td>
                                    <td class="px-4 py-3">@item.Nome</td>
                                    <td class="px-4 py-3"><span class="badge bg-info text-dark">@item.Curso?.CursoNome</span></td>
                                    <td class="px-4 py-3">@item.CargaHoraria h</td>
                                    <td class="px-4 py-3 text-end">
                                        <button class="btn btn-sm btn-outline-primary me-2">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-collection"></i> Conteúdo
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Nenhuma disciplina encontrada.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
