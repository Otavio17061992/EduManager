<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduManager.styles.css" asp-append-version="true" />
</head>
<body>
    @if(User.Identity != null && User.Identity.IsAuthenticated)
    {
        <header>
            <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                        <div class="offcanvas-header border-bottom">
                            <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Menu EduManager</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>
                        <div class="offcanvas-body">
                            <ul class="navbar-nav justify-content-end flex-grow-1 pe-3">
                                <li class="nav-item">
                                    @if (User.IsInRole("Master"))
                                    {
                                        <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index"><i class="bi bi-house"></i> Home</a>
                                    }
                                    else if (User.IsInRole("Professor"))
                                    {
                                        <a class="nav-link text-dark" asp-controller="Professor" asp-action="Dashboard"><i class="bi bi-house"></i> Home</a>
                                    }
                                    else if (User.IsInRole("Aluno"))
                                    {
                                        <a class="nav-link text-dark" asp-controller="Aluno" asp-action="Home"><i class="bi bi-house"></i> Home</a>
                                    }
                                    else
                                    {
                                        <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-house"></i> Home</a>
                                    }
                                </li>

                                @if (User.IsInRole("Master"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-primary fw-bold" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock"></i> Painel Admin</a>
                                    </li>
                                }
                                
                                <li class="nav-item mt-3 border-top pt-2">
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="btn btn-outline-danger w-100">Sair (@User.Identity.Name)</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div>
                        @if (User.IsInRole("Master"))
                        {
                            <a class="navbar-brand" asp-controller="Admin" asp-action="Index">EduManager</a>
                        }
                        else if (User.IsInRole("Professor"))
                        {
                            <a class="navbar-brand" asp-controller="Professor" asp-action="Dashboard">EduManager</a>
                        }
                        else if (User.IsInRole("Aluno"))
                        {
                            <a class="navbar-brand" asp-controller="Aluno" asp-action="Home">EduManager</a>
                        }
                        else
                        {
                            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">EduManager</a>
                        }
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - EduManager - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
