@model EduManager.Models.Entities.Dominios.AlunoDominio

@{
    ViewData["Title"] = "Detalhes do Aluno";
}

<div class="container-fluid pb-5">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
        <h1 class="h2">Detalhes do Aluno: @Model.AlunoNomeCompleto</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">Voltar ao Dashboard</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Informações Pessoais</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Nome Completo</dt>
                        <dd class="col-sm-9">@Model.AlunoNomeCompleto</dd>

                        <dt class="col-sm-3">CPF</dt>
                        <dd class="col-sm-9">@Model.AlunoCPF</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.AlunoEmail</dd>

                        <dt class="col-sm-3">Data de Nascimento</dt>
                        <dd class="col-sm-9">@Model.AlunoDataNascimento.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3">Data de Matrícula</dt>
                        <dd class="col-sm-9">@Model.AlunoDataMatricula.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">@(Model.AlunoAtivo ? "Ativo" : "Inativo")</dd>

                        <dt class="col-sm-3">Curso</dt>
                        <dd class="col-sm-9">@Model.Curso?.CursoNome</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Ações</h5>
                </div>
                <div class="card-body">
                    <a href="#" class="btn btn-primary w-100 mb-2">Editar Aluno</a>
                    <a href="#" class="btn btn-warning w-100 mb-2">Ver Notas</a>
                    <a href="#" class="btn btn-info w-100">Ver Frequência</a>
                </div>
            </div>
        </div>
    </div>
</div>